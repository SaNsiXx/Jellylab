{
  "brand": {
    "name": "Jelly Labs",
    "positioning": "Bold outside. Reliable inside.",
    "headline": "Hard problems. Fluid teams.",
    "campaignLine": "Who the f*ck is Jelly?"
  },
  "colors": {
    "background": "#0B0B0F",
    "surface": "#101014",
    "surfaceElevated": "#17171D",
    "border": "rgba(245,245,247,0.10)",
    "textPrimary": "#F5F5F7",
    "textSecondary": "#A1A1AA",
    "lime": "#C6FF00",
    "violet": "#8B5CF6",
    "violetHi": "#A78BFA",
    "blend": "#D9E8A0",
    "red": "#FF4D5E",
    "focus": "#C6FF00"
  },
  "gradients": {
    "limeJelly": "linear-gradient(135deg, #E6FF80 0%, #C6FF00 48%, #8FB800 100%)",
    "violetJelly": "linear-gradient(135deg, #C4B5FD 0%, #8B5CF6 48%, #5B34C9 100%)",
    "matchJelly": "linear-gradient(100deg, #C6FF00 0%, #D9E8A0 45%, #8B5CF6 100%)"
  },
  "typography": {
    "display": "Outfit, sans-serif",
    "body": "1.125rem",
    "h1Desktop": "clamp(4.5rem, 8vw, 7rem)",
    "h1Mobile": "clamp(2.8rem, 14vw, 3.65rem)",
    "bodyLarge": "1.25rem",
    "small": "0.875rem",
    "mono": "JetBrains Mono, monospace"
  },
  "radii": {
    "button": "999px",
    "card": "28px",
    "modal": "28px"
  },
  "spacing": {
    "sectionDesktop": "clamp(7rem, 12vw, 11rem)",
    "sectionMobile": "5rem",
    "container": "min(1280px, calc(100vw - 48px))"
  },
  "motion": {
    "micro": "160ms",
    "standard": "420ms",
    "section": "720ms",
    "easing": [
      0.22,
      1,
      0.36,
      1
    ],
    "respectReducedMotion": true
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  }
}
