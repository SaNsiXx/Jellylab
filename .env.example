# ─────────────────────────────────────────────────────────────────────────────
# Jelly Labs website — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Only NEXT_PUBLIC_* variables reach the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # production: https://jellylabs.com · unset on Vercel previews (uses the deployment URL)
DEPLOY_ENV=development                             # set to "production" ONLY on the live deploy → enables indexing + placeholder gate
NEXT_PUBLIC_SHOW_PLACEHOLDERS=                     # "true" shows dev placeholders on a preview production build

# Double opt-in (server-only). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOI_SECRET=

# CRM (server-only): console | pipedrive
CRM_PROVIDER=console
PIPEDRIVE_API_TOKEN=

# Email / newsletter (server-only): console | brevo
MAIL_PROVIDER=console
BREVO_API_KEY=
BREVO_LIST_ID_JELLY_LIST=
BREVO_LIST_ID_SIGNAL=
BREVO_LIST_ID_MARKETING=
MAIL_FROM=hello@example.com
MAIL_FROM_NAME=Jelly Labs

# Rate limiting (server-only): memory | upstash
RATE_LIMIT_PROVIDER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CV storage (server-only): mock (dev only — refuses uploads in production)
CV_STORAGE_PROVIDER=mock

# Talent data source: mock | cms (implement lib/adapters/talent cms adapter)
TALENT_SOURCE=mock

# Analytics — loaded ONLY after consent
NEXT_PUBLIC_GA4_ID=                                # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=                   # LinkedIn Insight Tag partner id
NEXT_PUBLIC_LINKEDIN_CONVERSIONS={}                # e.g. {"jelly_list_submit":1234567,"client_request_submit":2345678}
